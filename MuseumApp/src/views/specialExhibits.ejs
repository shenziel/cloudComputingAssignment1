<html>  
    <head>
        <title>Special Exhibits</title>
        <link rel="stylesheet" type="text/css" href="/css/style.css">
         <dashboard>
            <button onclick="window.location.href='/'"> 
                Home Page 
            </button>
            <button onclick="window.location.href='/reploidBeginnings'"> 
                Reploid Beginnings
            </button>
            <button onclick="window.location.href='/submitExhibit'"> 
                Submit Exhibit
            </button>
            <search>
                <form action="/specialExhibits" method="GET">
                    <input type="text" name="search" placeholder="Search exhibits...">
                    <button type="submit">Search</button> 
                </form>
            </search>
        </dashboard>
    </head>
    <body>
        <header>
            <h1>Special Exhibits</h1>
        </header>
        <main>
            <p>Welcome to the Special Exhibits section of the Reploid Museum!</p>
            <ul>
                <% cards.forEach(card => { %>
                    <li>
                        <h2><%= card.title %></h2>
                        <p><%= card.description %></p>
                        <img src="<%= card.image %>" alt="<%= card.title %>" width="300" height="400">
                    </li>
                <% }) %>
            </ul>
        </main>
    </body>
</html>