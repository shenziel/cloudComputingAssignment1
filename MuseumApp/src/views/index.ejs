<html>
    <head>
        <title>Reploid Museum</title>
        <link rel="stylesheet" type="text/css" href="/css/style.css">
        <dashboard>
            <button onclick="window.location.href='/specialExhibits'"> 
                Special Exhibits 
            </button>
            <button onclick="window.location.href='/reploidBeginnings'"> 
                Reploid Beginnings
            </button>
            <button onclick="window.location.href='/submitExhibit'"> 
                Submit Exhibit
            </button>
        </dashboard>
    </head>
    <body>
        <header>
            <h1>Reploid Museum</h1>
        </header>
        <main>
            <p>Dr Cain, Proudly Welcomes you to the Reploid Museum!!!!</p>
            <ul>
                <% cards.forEach(card => { %>
                    <li>
                        <h2><%= card.title %></h2>
                        <p><%= card.description %></p>
                        <img src="<%= card.image %>" alt="<%= card.title %>" width="300" height="400">
                    </li>
                <% }); %>
            </ul>
        </main>
    </body>
</html>